{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "0aaeec5f-67de-4603-8ee6-63edee1b8073",
  "alias": "PageRollupWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "SharePointFullPage"],
  "supportsThemeVariants": true,
  "supportsFullBleed": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
    "group": { "default": "Advanced" },
    "title": { "default": "Page Rollup" },
    "description": { "default": "Roll up pages or documents from a site and library as modern thumbnail tiles, with column filters and date ranges." },
    "iconImageUrl": "data:image/svg+xml;base64,",
    "properties": {
      "title": "",
      "layout": "tiles"
    }
  },
  {
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
    "group": { "default": "Advanced" },
    "title": { "default": "Document Rollup" },
    "description": { "default": "Show documents from a library as preview tiles (Word, Excel, PowerPoint, PDF and more), with column filters and date ranges." },
    "iconImageUrl": "data:image/svg+xml;base64,",
    "properties": {
      "title": "",
      "startWith": "documents",
      "layout": "cards",
      "aspectRatio": "4:3",
      "hoverEffect": "lift",
      "dateField": "Modified",
      "overlayField1": "Title",
      "overlayField2": "Modified",
      "detailsField": "",
      "publishedOnly": false
    }
  }]
}

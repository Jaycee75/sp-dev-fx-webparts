{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "c8a344e4-b9e4-4431-a918-65d1a32a4dc9",
  "alias": "LikeWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  "requiresCustomScript": false,
  "supportsThemeVariants": true,
  "supportedHosts": ["SharePointWebPart", "SharePointFullPage", "TeamsTab"],

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Other
    "group": { "default": "Other" },
    "title": { "default": "Like button" },
    "description": { "default": "Let people like this page with a thumbs up, heart, star or emoji." },
    "officeFabricIconFontName": "Like",
    "properties": {
      "displayText": "Did you find this page helpful?",
      "likedText": "Thanks for your feedback!",
      "iconType": "thumb",
      "customEmoji": "👏",
      "size": "medium",
      "alignment": "left",
      "layout": "inline",
      "buttonStyle": "outline",
      "accentColor": "",
      "showCount": true,
      "countLabelSingular": "like",
      "countLabelPlural": "likes",
      "showLikers": true,
      "allowUnlike": true,
      "storage": "page",
      "listTitle": "PageLikes",
      "likeKey": ""
    }
  }]
}
